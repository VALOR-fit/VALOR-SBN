#!/bin/sh
# -*- sh-indentation: 3 -*-
#
# valor_lbnx-config a la ROOT's root-config
#

# VALOR/LBNx top directory path:
topdir=$VALOR_LBNX

# VALOR/LBNx libraries path:
libdir=$VALOR_LBNX/lib

# VALOR/LBNx src top level directory:
srcdir=$VALOR_LBNX/src

# VALOR/LBNx libraries:
libs="-L$libdir -lValorLBNxConv -lValorLBNxND"

#
# Usage
#

usage="\
Usage: valor_lbnx-config [--libs] [--libdir] [--srcdir] [--topdir]" 

if test $# -eq 0; then
   echo "${usage}" 1>&2
   exit 1
fi

out=""

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *)    optarg= ;;
  esac

  case $1 in
    --topdir)
      out="$out $topdir"
      ;;
    --libdir)
      out="$out $libdir"
      ;;
    --srcdir)
      out="$out $srcdir"
      ;;
    --libs)
      out="$out $libs"
      ;;
  esac
  shift
done

echo $out
