#!/bin/sh
# -*- sh-indentation: 3 -*-
#
# valor_expt-config a la ROOT's root-config
#

# VALOR/DUNE top directory path:
topdir=$VALOR_DUNE

# VALOR/DUNE libraries path:
libdir=$VALOR_DUNE/lib

# VALOR/DUNE src top level directory:
srcdir=$VALOR_DUNE/src

# VALOR/DUNE libraries:
libs="-lValorDuneConv -lValorDuneUtil -lValorDuneElements "

#VALOR/DUNE genie-dependent libraries
glibs="-lValorDuneGenieUtil -lValorDuneTesting"

#
# Usage
#

usage="\
Usage: valor_expt-config [--libs] [--libdir] [--glibs] [--srcdir] [--topdir]" 

if test $# -eq 0; then
   echo "${usage}" 1>&2
   exit 1
fi

out=""

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *)    optarg= ;;
  esac

  case $1 in
    --topdir)
      out="$out $topdir"
      ;;
    --libdir)
      out="$out $libdir"
      ;;
    --srcdir)
      out="$out $srcdir"
      ;;
    --libs)
      out="$out -L$libdir $libs"
      ;;
    --glibs)
      out="$out -L$libdir $glibs"
      ;;
  esac
  shift
done

echo $out
