#!/usr/bin/perl

#
#-------------------------------------------------------------------------------------------------------------------------------
# Submit a batch of macros/fit/nd/run_fit.C jobs
#
# Inputs
#  --resource               : Computer resource, <RAL, Oxford, Grid, ETH-Monch, interactive>. Default: interactive.
#  --tag                    : Tag for output files. Default: "toymc".
#  --nruns                  : Number of runs (jobs) to submit. Default: 1.
#  --ntoymc                 : Number of toy-MC fits per run. Default: 1.
#  --cpu-time               : Required CPU time. Default: "6:00:00" for RAL, "11:50:00" for Oxford.
#  --fit-param-list         : Specifies the fit parameter list. Default: "standard"
#  --param-values           : Specifies how to set model parameters in toy-MC generation. Default: "randomize-all;prefit-errors"
#  --no-stat-fluctuations   : Disable statistical fluctuation in toy-MC generation. Default: enabled.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --store-spectra          : Store the generated toy MC and best-fit spectra? Default: false.
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --lbnx-softw-dir         : VALOR/LBNx code top-level directory. Default: `pwd`.
#  --fmwk-softw-dir         : VALOR/FMWK code top-level directory. Default: `pwd`/../fmwk/
#  --config-file            : Analysis configuration file. Default: "lbne_ndfit-2014a-STT_baseline.xml".
#
# C.Andreopoulos
#-------------------------------------------------------------------------------------------------------------------------------
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'               ) { $resource            = $ARGV[$iarg+1]; }
  if($_ eq '--tag'                    ) { $tag                 = $ARGV[$iarg+1]; }
  if($_ eq '--nruns'                  ) { $nruns               = $ARGV[$iarg+1]; }
  if($_ eq '--ntoymc'                 ) { $ntoymc              = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'               ) { $cput                = $ARGV[$iarg+1]; }
  if($_ eq '--fit-param-list'         ) { $fitparamlist        = $ARGV[$iarg+1]; }
  if($_ eq '--param-values'           ) { $param_values        = $ARGV[$iarg+1]; }
  if($_ eq '--no-stat-fluctuations'   ) { $stat_fluct          = 0;              }
  if($_ eq '--fit-option'             ) { $fitoption           = $ARGV[$iarg+1]; }
  if($_ eq '--store-spectra'          ) { $store_spectra       = 1;              }
  if($_ eq '--job-dir'                ) { $job_dir             = $ARGV[$iarg+1]; }
  if($_ eq '--lbnx-softw-dir'         ) { $lbnx_softw_dir      = $ARGV[$iarg+1]; }
  if($_ eq '--fmwk-softw-dir'         ) { $fmwk_softw_dir      = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'            ) { $config_file         = $ARGV[$iarg+1]; }
  $iarg++;
}
$resource               = "interactive"                           unless defined $resource;
$tag                    = "toymc"                                 unless defined $tag;
$nruns                  = 1                                       unless defined $nruns;
$ntoymc                 = 1                                       unless defined $ntoymc;
$fitparamlist           = "standard"                              unless defined $fitparamlist;
$param_values           = "randomize-all;prefit-errors"           unless defined $param_values;
$stat_fluct             = 1                                       unless defined $stat_fluct;
$fitoption              = "minuit"                                unless defined $fitoption;
$store_spectra          = 0                                       unless defined $store_spectra;
$job_dir                = "."                                     unless defined $job_dir;
$lbnx_softw_dir         = "."                                     unless defined $lbnx_softw_dir;
$fmwk_softw_dir         = "../fmwk/"                              unless defined $fmwk_softw_dir;
$config_file            = "lbne_ndfit-2014a-STT_baseline.xml"     unless defined $config_file;

if( !defined $cput ) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

$irun = 0;
while($irun < $nruns) {
  print "Submitting run: $irun \n";

  $command = "valor_lbnx -l -b -q \'$lbnx_softw_dir/macros/fit/nd/run_fit.C(\"$tag\",$irun,$ntoymc,\"$fitparamlist\",\"$param_values\",$stat_fluct,\"$fitoption\",$store_spectra,\"$config_file\")\'";
  print "Running: $command \n";
  
  #
  # ETH (Monch cluster), $job_dir not used, $tag gives path/name of output file
  #
  if($resource eq "ETH-Monch") {
      open(PBS, ">/mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch") or die("Can not create the sbatch script");
      print PBS "#!/bin/bash -l  \n";
      print PBS "#SBATCH --partition=dphys_compute  \n";
      print PBS "#SBATCH --nodes=1  \n";
      print PBS "#SBATCH --ntasks-per-node=1  \n";
      print PBS "#SBATCH --output=/mnt/lnec/davides/VALOR/outputs/out.%j.o  \n";
      print PBS "#SBATCH --error=/mnt/lnec/davides/VALOR/outputs/out.%j.e  \n";
      print PBS "$command \n";
      close(PBS);
      `sbatch -t 00:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
  }
      
  #
  # RAL
  #
  if($resource eq "RAL") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$irun \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "#PBS -q prod \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "cd $job_dir \n";
     print PBS "source $lbnx_softw_dir/setup/setup_at_ral.sh $lbnx_softw_dir $fmwk_softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$tag-$irun.pbs`;
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$irun \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "cd $job_dir \n";
     print PBS "source $lbnx_softw_dir/setup/setup_at_oxford.sh $lbnx_softw_dir $fmwk_softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub $job_dir/$tag-$irun.pbs`;
  }
  #
  # Grid
  #
  if($resource eq "Grid") {
     print "Not supported just yet!\n";
  }
  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

  $irun++;
}
