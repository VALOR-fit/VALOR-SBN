  <systematics name="DUNEND_2016b">
    <group name="flux">
      <class> valor::MINERVAFlux2016aNDFHC </class>
      
      <covariance_matrix>
        <filename>   dune/ndfit/2016b/flux/opt_split_fhc_rhc_for_nd.root </filename>
        <objname>    nd_fhc_only_cov  </objname>    
        <objtype>    TMatrixD           </objtype>
      </covariance_matrix> 
    </group>
    
    <group name="interaction">
      <class> valor::VALORInt2017a </class>
      <covariance_matrix>
         <filename>   dune/ndfit/2017a/xsec/xsec_covariance_LBNEND.root </filename>
         <objname>    frac_cov_max    </objname>    
         <objtype>    TMatrixD          </objtype>
      </covariance_matrix>
    </group>
    
    <group name="detector">
      <class> valor::SimpleDet2016bND </class>
      <covariance_matrix>
         <filename>   test/dummy_detector_matrices.root </filename>
         <objname>    diag_7x7_15pct    </objname>    
         <objtype>    TMatrixD          </objtype>
      </covariance_matrix>
    </group>
    
  </systematics>

