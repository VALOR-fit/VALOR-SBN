  <systematics name="DUNE_2016b">
    <group name="flux">
      <class> valor::MINERVAFlux2016aFD </class>
      
      <covariance_matrix>
        <filename>   dune/ndfit/2016a/flux/2016av1_flux_optimized.root </filename>
        <objname>    far_only    </objname>    
        <objtype>    TMatrixD    </objtype>
      </covariance_matrix> 
    </group>
    
    <group name="interaction">
      <class> valor::VALORInt2016a </class>
      <covariance_matrix>
         <filename>   dune/ndfit/2016a/xsec/xsec_covariance_2016a_gevgen_v2.root </filename>
         <objname>    frac_cov_max    </objname>    
         <objtype>    TMatrixD          </objtype>
      </covariance_matrix>
    </group>
    
    <group name="detector">
      <class> valor::SimpleDet2016b </class>
      <covariance_matrix>
         <filename>   test/dummy_detector_matrices.root </filename>
