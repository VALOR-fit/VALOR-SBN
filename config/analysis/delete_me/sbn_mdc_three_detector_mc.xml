<?xml version="1.0"?>

<valor> 

  <element_list name="sbncode">
<!--
   Near detector selections
-->

<!-- FHC -->
    <element name="sbn_nd_fhc_mockdata1_numuCCIncl">
      <detector>     sbn_nd                                               </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       numulikeCChigh                                       </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_nd_mdc.xml                                    </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuMu.xml                </binning>
    </element>
    
    <element name="sbn_ub_fhc_mockdata1_numuCCIncl">
      <detector>     sbn_uboone                                           </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       numulikeCChigh                                       </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_ub_mdc.xml                                    </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuMu.xml                </binning>
    </element>
    
    <element name="sbn_fd_fhc_mockdata1_numuCCIncl">
      <detector>     sbn_icarus                                           </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       numulikeCChigh                                       </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_fd_mdc.xml                                    </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuMu.xml                </binning>
    </element>
    
  </element_list>
    
  <parameter_definitions>
    <filename desc="sterile_physics_parameter_values"> params/sterile_physics_parameter_values.xml </filename>
    <filename desc="sbnd_flux_etrue_parameters">       params/sbn/flux_sbn_nd_etrue.xml            </filename>
    <filename desc="uboone_flux_etrue_parameters">     params/sbn/flux_sbn_ub_etrue.xml            </filename>
    <filename desc="icarus_flux_etrue_parameters">     params/sbn/flux_sbn_fd_etrue.xml            </filename>
    <filename desc="sbn_xsec_ereco_parameters">        params/sbn/int_numu_ereco.xml               </filename>
  </parameter_definitions>

  <systematics name="SBN">
    <group name="flux">
      <format> SBNFlux_Etrue.xml </format>
      
      <covariance_matrix>
        <filename>   sbn/syst/proposal/updated/etrue_flux.root </filename>
        <objname>    frac_cov            </objname>    
        <objtype>    TMatrixD                  </objtype>
      </covariance_matrix> 
    </group>

    <group name="int">
      <format> SBNIntNumu.xml </format>
      
      <covariance_matrix>
        <filename>   sbn/syst/proposal/updated/interaction.root </filename>
        <objname>    frac_cov            </objname>    
        <objtype>    TMatrixD                  </objtype>
      </covariance_matrix> 
    </group>
    
  </systematics>
    
</valor> 
