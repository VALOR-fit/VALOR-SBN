<?xml version="1.0"?>

<valor> 

  <element_list name="sbn_nue_app_dom_modrn6thNov">

<!-- FHC -->
    <element name="sbn_nd_modern_nueCCIncl">
      <detector>     sbn_nd                                               </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       nuelikeCChigh                                        </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_nue_app_dom_28Nov_sbn_nd.xml               </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuE.xml                 </binning>
    </element>

    <element name="sbn_ub_modern_nueCCIncl">
      <detector>     sbn_uboone                                           </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       nuelikeCChigh                                        </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_nue_app_dom_28Nov_sbn_ub.xml               </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuE.xml                 </binning>
    </element>

    <element name="sbn_fd_modern_nueCCIncl">
      <detector>     sbn_icarus                                           </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       nuelikeCChigh                                        </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_nue_app_dom_28Nov_sbn_fd.xml               </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuE.xml                 </binning>
    </element>
    
  </element_list>
  
  <parameter_definitions>
    <filename desc="sterile_physics_parameters">       params/sterile_physics_parameter_values.xml </filename>
    <filename desc="sbnd_flux_etrue_parameters">       params/flux_sbn_nd_etrue.xml            </filename>
    <filename desc="uboone_flux_etrue_parameters">     params/flux_sbn_ub_etrue.xml            </filename>
    <filename desc="icarus_flux_etrue_parameters">     params/flux_sbn_fd_etrue.xml            </filename>
    <filename desc="sbn_xsec_ereco_parameters">        params/int_nue_ereco.xml                </filename>
  </parameter_definitions>


  <systematics name="SBN">
    <group name="flux">
      <format> SBNFlux_Etrue.xml </format>
      
      <covariance_matrix>
        <filename>   sbn_nue_appearance/prior_errors/2020_new/flux_dom/flux_matrix.root </filename>
        <objname>    frac_cov            </objname>    
        <objtype>    TMatrixD            </objtype>
      </covariance_matrix> 
    </group>


    <group name="int">
      <format> SBNIntNuE.xml </format>
      
      <covariance_matrix>
        <filename>   sbn_nue_appearance/prior_errors/01a1/interaction.root </filename> 
        <objname>    frac_cov            </objname>    
        <objtype>    TMatrixD                  </objtype>
      </covariance_matrix> 
    </group>

  </systematics>

</valor> 
