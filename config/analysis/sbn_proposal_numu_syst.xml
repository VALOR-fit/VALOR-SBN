<?xml version="1.0"?>

<valor> 

  <element_list name="sbncode">
<!--
   Near detector selections
-->

<!-- FHC -->
    <element name="sbn_nd_fhc_proposal_numuCCIncl">
      <detector>     sbn_nd                                               </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       numulikeCChigh                                       </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_nd_2-2_proposal.xml                           </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuMu.xml                </binning>
    </element>
    
    <element name="sbn_ub_fhc_proposal_numuCCIncl">
      <detector>     sbn_uboone                                           </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       numulikeCChigh                                       </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_ub_2-2_proposal.xml                           </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuMu.xml                </binning>
    </element>
    
    <element name="sbn_icarus_fhc_proposal_numuCCIncl">
      <detector>     sbn_icarus                                           </detector>
      <beam>         bnb_fhc                                              </beam>
      <sample>       numulikeCChigh                                       </sample>
      <observable>   Ereco                                                </observable>
      <data>                                                              </data>
      <mc>           mc/sbn_fd_2-2_proposal.xml                           </mc>
      <data_class>   valor::GenericSingleSampleFitData                    </data_class>
      <model_class>  valor::GenericSingleSampleFitModel                   </model_class>
      <binning>      binning/sbn_proposal_binning_NuMu.xml                </binning>
    </element>

  </element_list>
  
  <parameter_definitions>
    <filename> params/sbn/flux_sbn_nd_numu_ereco.xml </filename>
    <filename> params/sbn/flux_sbn_ub_numu_ereco.xml </filename>
    <filename> params/sbn/flux_sbn_fd_numu_ereco.xml </filename>
    <filename> params/sbn/int_numu_ereco.xml </filename>
  </parameter_definitions>

  <systematics name="SBN">
    <group name="flux">
      <format> SBNFluxNumu.xml </format>
      
      <covariance_matrix>
        <filename>   sbn/syst/proposal/updated/flux.root </filename>
        <objname>    frac_cov            </objname>    
        <objtype>    TMatrixD                  </objtype>
      </covariance_matrix> 
    </group>
    <group name="int">
      <format> SBNIntNumu.xml </format>
      
      <covariance_matrix>
        <filename>   sbn/syst/proposal/updated/interaction.root </filename>
        <objname>    frac_cov            </objname>    
        <objtype>    TMatrixD                  </objtype>
      </covariance_matrix> 
    </group>
    
  </systematics>
    
</valor> 
