<?xml version="1.0"?>

<analysis_inputs analysis="LBNE-NDFIT" version="2014a" config="STT-baseline">

<DetConfig>
  
  <InFile>                   FastMCfile.root                </InFile>
  <Events>                   1000000                        </Events>
  <NeutrinoPDG>              14                             </NeutrinoPDG>

  <!-- Kinematics parameters and thresholds -->
  <ReconNeutrinoEnergyCut>   0.1                            </ReconNeutrinoEnergyCut>

  <ReconPiPMEnergyCut>       0.05                           </ReconPiPMEnergyCut>
  <ReconKaonPMEnergyCut>     0.05                           </ReconKaonPMEnergyCut>
  <ReconProtonEnergyCut>     0.08                           </ReconProtonEnergyCut>
  <ReconElectronEnergyCut>   0.05                           </ReconElectronEnergyCut>
  <ReconGammaEnergyCut>      0.1                            </ReconGammaEnergyCut>
  <Pi0InvariantMassCut>      0.4                            </Pi0InvariantMassCut>

  <MaxMomentumPID>           0.8                            </MaxMomentumPID>
  <TrackLengthCut>           0.05                           </TrackLengthCut> 
  <EVisibleCut>              1.0                            </EVisibleCut>
  <EReconCut>                0.8                            </EReconCut>
  <ReconEfficiency>          0.95                           </ReconEfficiency>

  <!-- PID parameters -->
  <PionMisIDAsProton>        0.002                          </PionMisIDAsProton>
  <PionMisIDAsKaon>          0.029                          </PionMisIDAsKaon>
  <KaonMisIDAsPion>          0.096                          </KaonMisIDAsPion>
  <KaonMisIDAsProton>        0.030                          </KaonMisIDAsProton>
  <ProtonMisIDAsPion>        0.001                          </ProtonMisIDAsPion>
  <ProtonMisIDAsKaon>        0.010                          </ProtonMisIDAsKaon>

  <!-- Charge confusion parameters -->
  <ChargeConfMomSlope>       0.0004                         </ChargeConfMomSlope>
  <ChargeConfMomConst>      -5.31738                        </ChargeConfMomConst>
  <ChargeConfTrLSlope>      -0.0353907                      </ChargeConfTrLSlope>
  <ChargeConfTrLConst>      -1.91409                        </ChargeConfTrLConst>
  
  <!-- Apply reweghting -->
  <Reweight>                 0                              </Reweight>

  <!-- Verbosity level -->
  <Verbose>                  1                              </Verbose>
  
</DetConfig>

</analysis_inputs>
