<?xml version="1.0"?>

<analysis_inputs analysis="SBN-NDFIT" version="2020a1" detector="ND">

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Assumed exposure for various beam configurations
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<data>
  <exposure> 
    <bnb_fhc>
      6.6e+20
    </bnb_fhc>
    <bnb_rhc>
      0
    </bnb_rhc>
  </exposure>
</data>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Information about the detector configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<fiducial_mass>
  -1 <!-- simulated mass was 1.13kt. Desired mass is 40kt -->
</fiducial_mass>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Input MC templates
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<mc>
  <using_dst_format> 
     true 
  </using_dst_format> 

  <dst> 
    <bnb_fhc>
      <filename> sbn_nue_disappearance/dsts/2020a1/valor_sbncode_fhc_nueccinc_disappearance_SBND_minidst_mc.root  </filename> 
       <objname> valor_sbncode_mini_dst </objname> 
       <objtype> TTree    </objtype> 
    </bnb_fhc>
  </dst>
  
  <!-- in kg, for calculating CCinc xsec-->
  <interaction_mass> 
    -999 
  </interaction_mass>

</mc>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Modelists
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<modelist> modelists/fine/SBNOscLowE.xml </modelist>
<!--<modelist> modelists/fine/OscLowE.xml </modelist>-->
<coarse_modelist> modelists/coarse/coarse_mode_list_SBN_BNB_FHC_nuelikeCChigh.xml </coarse_modelist>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Default binning
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<default_binning> binning/sbn_proposal_binning_NuE.xml  </default_binning>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Splines
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<splines>
  <folder>         sbn_nue_appearance/prior_errors/2020/all_spline/sbnd  </folder>
  <pattern>        valor_splines_[SAMPLE]_[PARAM]_[BEAM]_[DET].root       </pattern>
  <type>           TSpline3                                               </type>
  <stored_as>      TObjArray                                              </stored_as>
  <array_pattern>  spl_[MODE]_[PARAM]                                     </array_pattern>
  <method>         curr_val                                               </method>
  <allow_negative> true                                                   </allow_negative>
</splines>


</analysis_inputs>


