<?xml version="1.0"?>

<analysis_inputs analysis="SBN-FDFIT" version="2019b3_02b1" detector="FD">

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Assumed exposure for various beam configurations
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<data>
  <exposure> 
    <bnb_fhc>
      6.6e+20
    </bnb_fhc>
    <bnb_rhc>
      0
    </bnb_rhc>
  </exposure>
</data>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Information about the detector configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<fiducial_mass>
  -1 <!-- simulated mass was 1.13kt. Desired mass is 40kt -->
</fiducial_mass>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Input MC templates
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<mc>
  <using_dst_format> 
     true 
  </using_dst_format> 

  <dst> 
    <bnb_fhc>
       <filename> sbn_numu_disappearance/dsts/2019b3/valor_sbncode_fhc_numuccinc_disappearance_fd_minidst_mc.root </filename>
       <objname> valor_sbncode_mini_dst </objname> 
       <objtype> TTree    </objtype> 
    </bnb_fhc>
  </dst>
  
  <!-- in kg, for calculating CCinc xsec-->
  <interaction_mass> 
    -999 
  </interaction_mass>

</mc>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Modelists
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<modelist> modelists/SBNOscLowE.xml </modelist>
<coarse_modelist> modelists/coarse/sbn/coarse_mode_list_SBN_BNB_FHC_numulikeCChigh.xml </coarse_modelist>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Default binning
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<default_binning> binning/sbn_proposal_binning_NuMu_universes.xml  </default_binning>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Splines
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<splines>
  <folder>         sbn_numu_disappearance/responses/02b1                  </folder>
  <pattern>        valor_splines_[SAMPLE]_[PARAM]_[BEAM].root             </pattern>
  <type>           TSpline3                                               </type>
  <stored_as>      TObjArray                                              </stored_as>
  <array_pattern>  spl_[MODE]_[PARAM]                                     </array_pattern>
  <method>         curr_val                                               </method>
  <allow_negative> true                                                   </allow_negative>
</splines>

</analysis_inputs>


