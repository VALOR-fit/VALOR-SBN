<?xml version="1.0"?>

<analysis_inputs analysis="T2K" version="run1-9d" detector="SuperK">

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Assumed exposure for various beam configurations
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<data>
  <exposure> 
    <jparc_fhc>
      1.4937977e+21
    </jparc_fhc>
    <jparc_rhc>
      1.634556e+21
    </jparc_rhc>
  </exposure>
</data>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Information about the detector configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<!-- This is (real detector fiducial mass) / (simulated fiducial mass) -->
<fiducial_mass>
  1.
</fiducial_mass>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Input MC templates
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<mc>
  <using_dst_format> 
     true
  </using_dst_format>

  <dst>
    <jparc_fhc>
       <filename> official/2018/superk/mc/mtuples_v2/valor_format/t2k_skmc14a_neut5.3.2.13a_tunedv1r1_valor_dst.root </filename>
       <objname>  valor_t2k_dst </objname>
       <objtype>  TTree </objtype>
    </jparc_fhc>
    <jparc_rhc>
        <filename> official/2018/superk/mc/mtuples_v2/valor_format/t2k_skmc14a_neut5.3.2.13a_tunedv1r1_valor_dst.root </filename>
        <objname>  valor_t2k_dst </objname>
        <objtype>  TTree </objtype>
    </jparc_rhc>
  </dst>
  
  <template>
    <filename> dune/ndfit/2016b/fd/nonexistent.root </filename>
    <tag> pass </tag>
  </template>
  
  <!-- in kg, for calculating CCinc xsec-->
  <interaction_mass> 
    -999 
  </interaction_mass>

</mc>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
External Tuning Histograms
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<tuning>

    <tuning_group name="NA61_event-by-event_flux_tuning">
        <type>      event-by-event                                </type>
        <operation> multiply                                      </operation>  <!-- TODO: Implement this as an option (it's currently assumed) -->
        <file>      mc/tuning/t2k_event_by_event_flux_tuning.xml  </file>
    </tuning_group>

</tuning>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Splines
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<splines>
    <folder>         official/2018/xsec/splines2018v1/valor_format      </folder>
    <pattern>        splines_spline2018v1erectheta_[BEAM]_[SAMPLE].root </pattern>
    <stored_as>      TObjArray                                          </stored_as>
    <array_pattern>  spl_[MODE]_[PARAM]                                 </array_pattern>
    <method>         curr_tweak                                         </method>  <!-- This uses weight = spline->Eval(current - untuned) -->
    <type>           akima                                              </type>
    <allow_negative> true                                               </allow_negative>      <!-- Splines that go negative are no longer replaced with flat splines, but the weight cannot go below 0 -->
</splines>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Default binning
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<default_binning> binning/t2k_rhc_elike_run1-9d_bins.xml </default_binning>

</analysis_inputs>


