    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  -->

  <param>
    <name>
      <simple> det_fhc_icarus_numucc_ncbkg_00 </simple>
    </name>
    <apply_to_range>
      <Ereco>  0.0, 0.2  </Ereco>
    </apply_to_range>

    <type>  normalisation  </type>

    <categories>
      <category>  detector  </category>
    </categories>

    <apply_to>
      <detector>   icarus         </detector>
      <beam>       fhc            </beam>
      <selection>  all  </selection>
      <reac_type>  allnc          </reac_type>
      <flav_init>  all            </flav_init>
      <flav_final> all            </flav_final>
      <target>     all            </target>
    </apply_to>

    <limits>  0.0, inf  </limits>

    <range_mode> sigma </range_mode>
    <range>      -8,8  </range>
  </param>

