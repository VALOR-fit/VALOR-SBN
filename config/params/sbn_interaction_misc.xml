<?xml version='1.0' encoding='utf-8'?>
<param_list name="v9_response_parameters">
  <!--===========================================================================================-->
  <param>
    <name>
      <simple>  C12ToAr402p2hScalingvbar </simple>
      <long>    C12ToAr40 2p2hScaling nubar </long>
      <rootex>  f_{C12ToAr40 2p2hScaling #bar{#nu}} </rootex>
      <tex>     f_{C12ToAr40 2p2hScaling \bar{\nu}} </tex>
    </name>
    <apply_to_range>
      <Etrue> 0, 10. </Etrue>
      <Ereco> 0, 10. </Ereco>
    </apply_to_range>
    <type>  response  </type>
    <categories>
      <category> int </category>
      <category> splines </category>
    </categories>
    <apply_to>
      <detector>    allsbn    </detector>
      <beam>        fhc       </beam>
      <selection>   all       </selection>
      <reac_type>   ccmec     </reac_type>
      <flav_init>   numubar       </flav_init>
      <flav_final>  numubar       </flav_final>
      <target>      all       </target>
    </apply_to>
    <limits>  -inf, inf  </limits>
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>
    <range>                  -5,5  </range>
  </param>
  <param>
    <name>
      <simple>  C12ToAr402p2hScalingv </simple>
      <long>    C12ToAr40 2p2hScaling nu </long>
      <rootex>  f_{C12ToAr40 2p2hScaling #nu} </rootex>
      <tex>     f_{C12ToAr40 2p2hScaling \nu} </tex>
    </name>
    <apply_to_range>
      <Etrue> 0, 10. </Etrue>
      <Ereco> 0, 10. </Ereco>
    </apply_to_range>
    <type>  response  </type>
    <categories>
      <category> int </category>
      <category> splines </category>
    </categories>
    <apply_to>
      <detector>    allsbn    </detector>
      <beam>        fhc       </beam>
      <selection>   all       </selection>
      <reac_type>   ccmec     </reac_type>
      <flav_init>   numu       </flav_init>
      <flav_final>  numu       </flav_final>
      <target>      all       </target>
    </apply_to>
    <limits>  -inf, inf  </limits>
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>
    <range>                  -5,5  </range>
  </param>
  <param>
    <name>
      <simple>  SPPLowQ2Suppression </simple>
      <long>    SPPLowQ2Suppression </long>
      <rootex>  f_{SPPLowQ2Suppression} </rootex>
      <tex>     f_{SPPLowQ2Suppression} </tex>
    </name>
    <apply_to_range>
      <Etrue> 0, 10. </Etrue>
      <Ereco> 0, 10. </Ereco>
    </apply_to_range>
    <type>  response  </type>
    <categories>
      <category> int </category>
      <category> splines </category>
    </categories>
    <apply_to>
      <detector>    allsbn    </detector>
      <beam>        fhc       </beam>
      <selection>   all       </selection>
      <reac_type>   allcc1pi  </reac_type>
      <flav_init>   numuany       </flav_init>
      <flav_final>  numuany       </flav_final>
      <target>      all       </target>
    </apply_to>
    <limits>  -inf, inf  </limits>
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>
    <range>                  -5,5  </range>
  </param>
</param_list>
