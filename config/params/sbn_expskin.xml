<?xml version="1.0"?>
<param_list name="flux_response_parameters">
  <!-- ==================================================================================== -->
  <param>
    <name>
      <simple>  expskin_FluxUnisim </simple>
      <long>    Skin Effect </long>
      <rootex>  Skin #: Effect </rootex>
      <tex>     Skin \: Effect </tex>
    </name>
    
    <apply_to_range>
      <Etrue> 0, 10. </Etrue>
      <Ereco> 0, 10. </Ereco>
    </apply_to_range>
    
    <type>  response  </type>
    
    <categories>
      <category> flux </category>
      <category> flux_uncorr </category>
    </categories>
    
    <apply_to>
      <detector>    allsbn    </detector>
      <beam>        fhc       </beam>
      <selection>   all       </selection>
      <reac_type>   all       </reac_type>
      <flav_init>   all       </flav_init>
      <flav_final>  all       </flav_final>
      <target>      all       </target>
    </apply_to>
    
    <limits>  -inf, inf  </limits>
    
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>            
    <range>                  -5,5  </range>                 

  </param>
  <!-- ==================================================================================== -->
</param_list>
