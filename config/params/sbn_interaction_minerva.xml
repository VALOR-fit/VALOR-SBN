<?xml version='1.0' encoding='utf-8'?>
<param_list name="v9_response_parameters">
  <!--===========================================================================================-->
  <param>
    <name>
      <simple>  E2p2hAvbar </simple>
      <long>    E2p2h A nubar </long>
      <rootex>  f_{E2p2h A #bar{#nu}} </rootex>
      <tex>     f_{E2p2h A \bar{\nu}} </tex>
    </name>
    <apply_to_range>
      <Etrue> 0, 10. </Etrue>
      <Ereco> 0, 10. </Ereco>
    </apply_to_range>
    <type>  response  </type>
    <categories>
      <category> int </category>
      <category> splines </category>
    </categories>
    <apply_to>
      <detector>    allsbn    </detector>
      <beam>        fhc       </beam>
      <selection>   all       </selection>
      <reac_type>   ccmec     </reac_type>
      <flav_init>   numubar       </flav_init>
      <flav_final>  numubar       </flav_final>
      <target>      all       </target>
    </apply_to>
    <limits>  -inf, inf  </limits>
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>
    <range>                  -5,5  </range>
  </param>
  <param>
