<?xml version="1.0"?>
<param_list name="sbn_interaction_parameters">
  <!-- ==================================================================================== -->
  <param>
    <name>
      <simple>  genie_ccresAxial_Genie </simple>
      <long>    CC Resonant Axial      </long>
      <rootex>  CC_{Res} #: M_{A}         </rootex>
      <tex>     CC_{Res} \: M_{A}         </tex>
    </name>
    
    <apply_to_range>
      <Etrue> 0, 10. </Etrue>
      <Ereco> 0, 10. </Ereco>
    </apply_to_range>
    
    <type>  response  </type>
    
    <categories>
      <category> int </category>
      <category> proposal </category>
    </categories>
    
    <apply_to>
      <detector>    allsbn    </detector>
      <beam>        fhc       </beam>
      <selection>   all       </selection>
      <reac_type>   allccn0pi </reac_type>
      <flav_init>   all       </flav_init>
      <flav_final>  all       </flav_final>
      <target>      all       </target>
    </apply_to>
    
    <limits>  -inf, inf  </limits>
    
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>            
    <range>                  -5,5  </range>                 

  </param>
  <!-- ==================================================================================== -->
</param_list>
