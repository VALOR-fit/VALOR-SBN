<?xml version="1.0" encoding="ISO-8859-1"?>

<messenger_config>

  <!-- 
    Defines the priority levels for VALOR message streams.
    The priority (in descending importance order) can be 
    FATAL, ALERT, CRIT, ERROR, WARN, NOTICE, INFO, DEBUG.
   -->

  <priority msgstream="Messenger">    NOTICE   </priority>
  <priority msgstream="Rnd">          NOTICE   </priority>
  <priority msgstream="XML">          NOTICE   </priority>
  <priority msgstream="NDData">       NOTICE   </priority>
  <priority msgstream="NDModel">      NOTICE   </priority>
  <priority msgstream="NDArrIdx">     FATAL    </priority>
  <priority msgstream="NDBinning">    NOTICE   </priority>
  <priority msgstream="InputMC">      NOTICE   </priority>
  <priority msgstream="HACK">         FATAL    </priority>

</messenger_config>
