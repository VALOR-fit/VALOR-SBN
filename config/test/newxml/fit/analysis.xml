<?xml version="1.0"?>

<valor> 
   
	<!--
		A single element_list contains all of the samples for the analysis
	-->
  <element_list name="analysis_name">
		<!--
			Each element_list can contain an arbitrary number of elements,
			which define the samples.
			
			Recommended element name format:
				<exp>_<det>_<beam>_<reac mode>
		 -->
		<element name="sample_name">
			<detector>dune_nd</detector>
			<beam>lbnf_fhc</beam>
			<sample>numucc0pi1trk</sample>
			<observable>Ereco,yreco</observable>
			<data>observations.root</data>
			<mc>mc/dune_ndfit_2017a_FGT_pt4.xml</mc>
			<data_class>valor::GenericSingleSampleFitData</data_class>
			<model_class>valor::GenericSingleSampleFitModel</model_class>
		</element>
	</element_list>
	<!--
		A single systematics element contains all of the different categories
		of systematics for the analysis.
	-->
	<systematics name="systematics_name">
		<!--
			Each systematcis element can contain an arbitrary number of groups,
			which define a particular category of systematics, e.g. flux.
		-->
		<group name="flux">
			<class>valor::MINERVAFlux2016aND</class>
			<!--
				The covariance_matrix element specifies where the covariance
				matrix associated with the systematics can be found, along with
				the object name and type in the ROOT file.
			-->
			<covariance_matrix>
				<filename>dune_nd_fhc_flux.root</filename>
				<objname>nd_covariance</objname>   
				<objtype>TMatrixD</objtype>
			</covariance_matrix> 
		</group>
	</systematics>
</valor> 

