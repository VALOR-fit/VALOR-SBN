<?xml version="1.0"?>
<parameters>
	<!--
		A set of default values for all parameters is used if not
		overriden below
	-->
	<defaults>
		<bestfit>1.0</bestfit>
		<init>1.0</bestfit>
		<minimum>0.0</minimum>
		<maximum>2.0</maximum>
		<step_size>0.0001</stepsize>
		<scaling>1.0</scaling>
		<fixed>false</fixed>
		<nuisance>true</nuisance>
		<marginalise>false</marginalise>
	</defaults>
	<!--
		Parameter names follow the convention used in the old enum format,
		e.g. kPhypMixing23
	-->
	<parameter name="kPhypMixing13">
		<!-- Optionally override the default values -->
		<bestfit>0.093</bestfit>
		<init>0.093</init>
		<minimum>0.077</minimum>
		<maximum>0.109</maximum>
		<nuisance>false</nuisance>
		<marginalise>true</marginalise>
		<!-- Optionally, errors can also be specified -->
		<errors>
			<!-- Choose one of migrad, hesse or minos -->
			<migrad>
				<error>0.0</error>
			</migrad>		
			<hesse>
				<error>0.0</error>
			</hesse>
			<minos>
				<low_error>0.0</low_error>
				<high_error>0.0</high_error>
			</minos>
		</errors>
	</parameter>
</parameters>

